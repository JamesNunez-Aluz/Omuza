# Resonance environment configuration.
# Copy to .env and fill in values. Never commit .env.
# All values here are synthetic defaults for local development only.

NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgres://resonance:resonance_dev_password@localhost:5432/resonance

# Web app
WEB_PORT=3000

# Worker health server
WORKER_HEALTH_PORT=3001

# Feature flags — the core product must work with Spotify export disabled.
FEATURE_SPOTIFY_EXPORT=false

# Local email (Mailpit SMTP, no auth in dev)
SMTP_HOST=localhost
SMTP_PORT=1025

# Spotify export adapter (Milestone 4 — leave empty; export-only, never used
# for recommendations, taste profiles, analytics of taste, or model training)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
