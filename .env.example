# Resonance environment configuration.
# Copy to .env and fill in values. Never commit .env.
# All values here are synthetic defaults for local development only.

NODE_ENV=development
LOG_LEVEL=debug
APP_BASE_URL=http://localhost:3000

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgres://resonance:resonance_dev_password@localhost:5432/resonance

# Web app
WEB_PORT=3000

# Worker health server
WORKER_HEALTH_PORT=3001

# Feature flags — the core product must work with Spotify export disabled.
FEATURE_SPOTIFY_EXPORT=false
FEATURE_MUSICBRAINZ_PROVIDER=true
# ListenBrainz stays off until endpoint terms + commercial rights are reviewed
# and the license registry entry is updated (ADR required; see registry notes).
FEATURE_LISTENBRAINZ_PROVIDER=false
LISTENBRAINZ_BASE_URL=https://api.listenbrainz.org

# MusicBrainz (core CC0 data only; set a real contact before production use)
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT=Resonance/0.1.0 (dev@resonance.local)

# Local email (Mailpit SMTP, no auth in dev; UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=login@resonance.local

# Spotify export pilot (Milestone 4). Export-only: never used for
# recommendations, taste profiles, analytics of taste, or model training.
# Enabling requires the signed checklist in
# docs/compliance/spotify-pilot-checklist.md. Local dev redirect uses
# 127.0.0.1 (not localhost), per Spotify requirements.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/v1/connections/spotify/callback
SPOTIFY_ACCOUNTS_BASE_URL=https://accounts.spotify.com
SPOTIFY_API_BASE_URL=https://api.spotify.com
# Comma-separated pilot emails (Development Mode allowlist)
SPOTIFY_PILOT_ALLOWLIST=
# 32-byte base64 key for AES-256-GCM token encryption (ADR 0012).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY_B64=
TOKEN_ENCRYPTION_KEY_VERSION=v1
