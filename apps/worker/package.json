{
  "name": "@resonance/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
