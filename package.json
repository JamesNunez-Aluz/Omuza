{
  "name": "resonance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  },
  "scripts": {
    "dev": "docker compose up -d postgres mailpit && turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "policy:check": "tsx scripts/verify-policy-boundaries.ts && tsx scripts/verify-feature-provenance.ts",
    "db:migrate": "pnpm --filter @resonance/db migrate",
    "db:seed": "tsx scripts/seed-demo-data.ts",
    "report:funnel": "tsx scripts/funnel-report.ts",
    "purge:provider-data": "tsx scripts/purge-expired-provider-data.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm policy:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0"
  }
}
